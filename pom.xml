<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.testable</groupId>
    <artifactId>testable-whitebox-java</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Testable Metrics Java Sample</name>
    <description>
        Monolithic Java 17 sample that triggers Primary tools from
        Testable_Strategy_Metrics_Mapping_v0.2 across White Box, Black Box,
        Security/Compliance Code, Performance Code, and URL/API sheets
        (via SampleApiServer + Newman/k6/ZAP/Playwright).
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>5.10.2</junit.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pmd.version>3.25.0</pmd.version>
        <checkstyle.plugin.version>3.5.0</checkstyle.plugin.version>
        <spotbugs.plugin.version>4.8.6.4</spotbugs.plugin.version>
        <dependency.check.version>10.0.4</dependency.check.version>
        <pitest.version>1.17.3</pitest.version>
        <pitest.junit5.version>1.2.2</pitest.junit5.version>
        <ck.version>0.7.0</ck.version>
        <archunit.version>1.3.0</archunit.version>
        <reports.dir>${project.basedir}/reports</reports.dir>
        <!-- Default empty; JaCoCo prepare-agent appends its agent here -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <!-- Intentionally outdated / vulnerable for OWASP Dependency-Check -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.9.10</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Performance Code — circular dependency detection -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <argLine>${argLine}</argLine>
                </configuration>
            </plugin>

            <!-- JaCoCo — statement / branch / path coverage proxy -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- Taxonomy gate expects target/site/jacoco/jacoco.xml -->
                    <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>jacoco-xml</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                                <format>CSV</format>
                            </formats>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-jacoco-to-reports</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <outputDirectory>${reports.dir}/jacoco</outputDirectory>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                                <format>CSV</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle — lint / rule violations -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>config/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>false</failsOnError>
                    <failOnViolation>false</failOnViolation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
            </plugin>

            <!-- PMD + CPD — cognitive complexity / lint / duplication -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.version}</version>
                <configuration>
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <linkXRef>false</linkXRef>
                    <includeTests>false</includeTests>
                    <minimumTokens>40</minimumTokens>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <!-- Taxonomy java-perf-dependency runner reads target/pmd.xml -->
                    <targetDirectory>${project.build.directory}</targetDirectory>
                    <rulesets>
                        <ruleset>/category/java/bestpractices.xml</ruleset>
                        <ruleset>/category/java/codestyle.xml</ruleset>
                        <ruleset>/category/java/design.xml</ruleset>
                        <ruleset>/category/java/errorprone.xml</ruleset>
                        <ruleset>/category/java/performance.xml</ruleset>
                        <ruleset>/category/java/security.xml</ruleset>
                        <ruleset>config/pmd-ruleset.xml</ruleset>
                        <ruleset>config/pmd-perf-dependency.xml</ruleset>
                    </rulesets>
                </configuration>
            </plugin>

            <!-- SpotBugs — SAST. Taxonomy gate expects target/spotbugsXml.xml (standard
                 Maven convention); do NOT redirect xmlOutputDirectory away from target/. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <failOnError>false</failOnError>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <xmlOutput>true</xmlOutput>
                    <htmlOutput>true</htmlOutput>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.13.0</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>

            <!-- OWASP Dependency-Check — SCA / CVE -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency.check.version}</version>
                <configuration>
                    <failBuildOnCVSS>11</failBuildOnCVSS>
                    <format>ALL</format>
                    <!-- Taxonomy owasp-depcheck runner reads target/dependency-check-report.xml -->
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <nvdApiDelay>4000</nvdApiDelay>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/config/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
            </plugin>

            <!-- PIT — mutation testing -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.testable.whitebox.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.testable.whitebox.*</param>
                    </targetTests>
                    <outputFormats>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <!-- Taxonomy gate expects target/pit-reports/mutations.xml (standard location) -->
                    <reportsDirectory>${project.build.directory}/pit-reports</reportsDirectory>
                    <timestampedReports>false</timestampedReports>
                    <threads>1</threads>
                    <timeoutConstant>4000</timeoutConstant>
                    <timeoutFactor>2.0</timeoutFactor>
                    <jvmArgs>
                        <jvmArg>-Djava.awt.headless=true</jvmArg>
                        <jvmArg>-XX:+EnableDynamicAgentLoading</jvmArg>
                    </jvmArgs>
                    <excludedClasses>
                        <!-- Runtime.exec / JDBC surfaces destabilize the PIT minion -->
                        <param>com.testable.whitebox.AuthService</param>
                    </excludedClasses>
                    <excludedTestClasses>
                        <param>com.testable.whitebox.AuthServiceTest</param>
                    </excludedTestClasses>
                    <mutators>
                        <mutator>DEFAULTS</mutator>
                    </mutators>
                </configuration>
            </plugin>

            <!-- CK — cyclomatic / coupling / WMC metrics (mauricioaniche/ck) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>copy-ck</id>
                        <phase>validate</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.github.mauricioaniche</groupId>
                                    <artifactId>ck</artifactId>
                                    <version>${ck.version}</version>
                                    <classifier>jar-with-dependencies</classifier>
                                    <destFileName>ck.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/tools</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.testable.whitebox.SampleApiServer</mainClass>
                </configuration>
            </plugin>

            <!-- Taxonomy gate: stage JaCoCo baseline before tests / coverage delta -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-jacoco-baseline-for-gate</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/baselines</directory>
                                    <includes>
                                        <include>jacoco-baseline.xml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>all-metrics</id>
            <build>
                <defaultGoal>verify</defaultGoal>
            </build>
        </profile>
        <!-- Taxonomy gate: java-perf-dependency runner -->
        <profile>
            <id>java-perf-dependency</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>java-perf-dependency-pmd</id>
                                <phase>verify</phase>
                                <goals><goal>pmd</goal></goals>
                                <configuration>
                                    <targetDirectory>${project.build.directory}</targetDirectory>
                                    <includeTests>false</includeTests>
                                    <rulesets>
                                        <ruleset>config/pmd-perf-dependency.xml</ruleset>
                                    </rulesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-pmd-for-gate</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/.testable/pmd"/>
                                        <copy file="${project.build.directory}/pmd.xml"
                                              tofile="${project.basedir}/.testable/pmd/pmd.xml"
                                              failonerror="false"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Taxonomy gate: Coverage Delta baseline + current JaCoCo XML -->
        <profile>
            <id>coverage-delta</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>mirror-jacoco-baseline-testable</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/.testable/jacoco"/>
                                        <copy file="${project.basedir}/baselines/jacoco-baseline.xml"
                                              tofile="${project.basedir}/.testable/jacoco/jacoco-baseline.xml"
                                              failonerror="true"/>
                                        <copy file="${project.basedir}/baselines/jacoco-baseline.xml"
                                              tofile="${project.build.directory}/jacoco-baseline.xml"
                                              failonerror="true"/>
                                    </target>
                                </configuration>
                            </execution>
                            <!-- Mirror the CURRENT run's JaCoCo XML too, so a worker that only
                                 reads .testable/ (no live `mvn test`) has both sides of the delta. -->
                            <execution>
                                <id>mirror-jacoco-current-testable</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/.testable/jacoco"/>
                                        <copy file="${project.build.directory}/site/jacoco/jacoco.xml"
                                              tofile="${project.basedir}/.testable/jacoco/jacoco-current.xml"
                                              failonerror="false"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Pre-compute the delta JSON itself and stage it as static evidence -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>compute-coverage-delta-testable</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>python</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/run_coverage_delta.py</argument>
                                    </arguments>
                                    <failOnError>false</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Taxonomy gate: SpotBugs SAST — stage static evidence in .testable/ in case the
             worker's own SpotBugs/FindSecBugs invocation cannot resolve the plugin jars. -->
        <profile>
            <id>spotbugs-evidence</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotbugs-for-gate</id>
                                <phase>verify</phase>
                                <goals><goal>spotbugs</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-spotbugs-for-gate</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/.testable/spotbugs"/>
                                        <copy file="${project.build.directory}/spotbugsXml.xml"
                                              tofile="${project.basedir}/.testable/spotbugs/spotbugsXml.xml"
                                              failonerror="false"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Taxonomy gate: PIT mutation testing — stage static evidence in .testable/ since
             full mutation runs are too slow for most worker sandboxes to execute live. -->
        <profile>
            <id>pit-evidence</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <executions>
                            <execution>
                                <id>pit-for-gate</id>
                                <phase>verify</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-pit-for-gate</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/.testable/pit"/>
                                        <copy file="${project.build.directory}/pit-reports/mutations.xml"
                                              tofile="${project.basedir}/.testable/pit/mutations.xml"
                                              failonerror="false"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
